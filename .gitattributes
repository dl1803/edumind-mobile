# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Source and configuration files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.ico binary
*.jar binary
*.aar binary

